# name: benchmark/vss/sync_insert.benchmark
# description: Sync after inserting 191,520 rows into an indexed table of 300,000 rows: the insert fills the open row group (appended to its mirror) and adds new row groups (built)
# group: [vss]

name Sync DUCKIR_VSS after insert
group vss

require core_functions

require duckir

load
CREATE TABLE base AS SELECT range AS id, list_transform(range(128), lambda d: (hash(range * 128 + d) % 1000000)::FLOAT / 1000000)::FLOAT[128] AS emb FROM range(491520);
CREATE TABLE t AS FROM base WHERE id < 300000;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = 'f32', seed = 0);

run
INSERT INTO t FROM base WHERE id >= 300000;
CALL duckir_vss_sync_index('idx');

cleanup
DROP TABLE t;
CREATE TABLE t AS FROM base WHERE id < 300000;
CREATE INDEX idx ON t USING DUCKIR_VSS (emb) WITH (quantization = 'f32', seed = 0);
